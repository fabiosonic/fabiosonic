# ---------- Banco de dados ----------
MO_DATABASE_URL=sqlite:///./dados/mo_obrigacoes.db

# ---------- Acesso ao painel (HTTP Basic) ----------
MO_ADMIN_USER=admin
MO_ADMIN_PASSWORD=troque-esta-senha

# ---------- Google Drive ----------
# "google" para produção (conta de serviço) ou "local" para testar com uma pasta do computador
MO_DRIVE_BACKEND=google
MO_GOOGLE_CREDENTIALS=./credenciais/service-account.json
# Para Google Workspace com delegação em todo o domínio (opcional): e-mail do usuário dono das pastas
MO_GOOGLE_IMPERSONATE=
# ID da pasta raiz "Clientes" no Drive (usado para criar a estrutura padrão de pastas)
MO_DRIVE_ROOT_FOLDER_ID=
# Quando MO_DRIVE_BACKEND=local
MO_LOCAL_DRIVE_PATH=./dados/drive_local

# ---------- Monitoramento ----------
MO_SYNC_INTERVAL_MINUTES=15
MO_DIAS_ALERTA_VENCIMENTO=3

# ---------- E-mail (alertas e cobrança de documentos) ----------
MO_SMTP_HOST=smtp.gmail.com
MO_SMTP_PORT=587
MO_SMTP_USER=
MO_SMTP_PASSWORD=
MO_EMAIL_REMETENTE=Moraes e Oliveira Contabilidade <contato@moraeseoliveira.com.br>
MO_EMAIL_GESTOR=
# Envia cobrança automática ao cliente quando documento dele está atrasado (true/false)
MO_COBRANCA_AUTOMATICA_CLIENTE=false

# ---------- Webhook (WhatsApp via Z-API, Twilio, n8n, etc.) ----------
MO_WEBHOOK_URL=
