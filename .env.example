# Copie para .env e preencha. Nunca faça commit do .env.

# Claude (roteiros). Alternativa: rodar `ant auth login` e deixar em branco.
ANTHROPIC_API_KEY=

# ElevenLabs (voz clonada)
ELEVENLABS_API_KEY=

# HeyGen (avatar)
HEYGEN_API_KEY=

# Instagram Graph API (conta profissional ligada a uma página do Facebook)
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# 1 = modo de teste: não chama nenhuma API paga, gera voz/avatar de exemplo
# localmente e nunca publica. Use 0 só depois de configurar tudo.
DRY_RUN=1

# Studio Contábil
STUDIO_SECRET=                       # qualquer texto longo e aleatório (assina o cookie de login)
POSTIZ_API_KEY=
# O token do Instagram de cada perfil é informado na página do perfil, no próprio Studio.
