# Copie para .env e ajuste. NUNCA versione credenciais reais.

# Ambiente: "demo" (local/demonstração) ou "production".
# Em "production" contas de demonstração ficam bloqueadas e a caixa de e-mail local é desativada.
APP_ENV=demo

# URL pública da aplicação (usada em links de recuperação e verificação de origem/CSRF).
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Segredo da autenticação (mínimo 32 caracteres). Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=troque-por-um-segredo-aleatorio-com-32-caracteres-ou-mais

# Banco de desenvolvimento (docker compose ou PostgreSQL local).
DATABASE_URL=postgresql://app:app@localhost:5432/plataforma_dev?schema=public
# Banco isolado para testes de integração e ponta a ponta.
TEST_DATABASE_URL=postgresql://app:app@localhost:5432/plataforma_test?schema=public

# Envio de e-mail: "dev" grava mensagens na caixa local (/dev/emails).
# "none" não envia nada (apenas registra aviso). Provedor real: pendente (docs/implementado-e-pendente.md).
EMAIL_TRANSPORT=dev

# Limites de tentativas (janela em segundos / máximo de requisições por IP).
AUTH_RATE_LIMIT_SIGNIN_WINDOW=60
AUTH_RATE_LIMIT_SIGNIN_MAX=5
AUTH_RATE_LIMIT_RESET_WINDOW=300
AUTH_RATE_LIMIT_RESET_MAX=3

# Nível de log (trace, debug, info, warn, error).
LOG_LEVEL=info
