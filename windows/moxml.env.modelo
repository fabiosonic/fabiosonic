# Configuracao do M&O XML Captador (este arquivo fica em %PROGRAMDATA%\MO-XML-Captador\moxml.env)
# NUNCA coloque senhas de certificado aqui: elas ficam no cofre DPAPI (cadastro pelo painel).

# Operacao somente com notas reais das fontes oficiais (nao existe modo de simulacao).

# Banco: vazio = SQLite local. Producao recomendada: PostgreSQL
# MOXML_DATABASE_URL=postgresql+psycopg://moxml:SENHA_DO_BANCO@localhost:5432/moxml

MOXML_HOST=127.0.0.1
MOXML_PORTA=8765
# MOXML_API_TOKEN=defina-um-token-longo-se-o-painel-for-acessado-por-outras-maquinas

# Horarios diarios (Brasilia)
MOXML_HORARIOS_EXECUCAO=07:30,12:30,19:30

# Cadeia de certificados para validar os servidores da SEFAZ/SVRS (ver SEGURANCA.md)
# MOXML_CA_BUNDLE=C:\ProgramData\MO-XML-Captador\cadeia-icp-brasil.pem

# Pasta onde os XMLs sao gravados (padrao: %PROGRAMDATA%\MO-XML-Captador\xml)
# MOXML_RAIZ_XML=G:\Drives compartilhados\MORAES & OLIVEIRA CONTABILIDADE

# Google Drive (credencial fora do repositorio)
MOXML_GDRIVE_ATIVO=false
# MOXML_GDRIVE_CREDENCIAIS=C:\ProgramData\MO-XML-Captador\gdrive-token.json
# MOXML_GDRIVE_PASTA_RAIZ_ID=id_da_pasta_MORAES_E_OLIVEIRA_CONTABILIDADE

# Fornecedor comercial opcional (desligado). Chaves ficam no cofre, nao aqui.
MOXML_APISIMPLES_ATIVO=false
