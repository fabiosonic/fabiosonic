// ~/.openclaw/openclaw.json  (JSON5 - comentários são permitidos)
// Estratégia: gratuitos primeiro; Claude Haiku 5.5 (pago) só quando todos falharem
// por cota, limite de uso, falta de crédito ou indisponibilidade.
// Confira os nomes disponíveis com:  openclaw models list --provider <google|groq|openrouter|ollama|anthropic>
{
  agents: {
    defaults: {
      workspace: "~/.openclaw/workspace",
      model: {
        // 1) Gratuito: Google AI Studio (plano gratuito com limite diário)
        primary: "google/gemini-3.8-flash",
        fallbacks: [
          // 2) Gratuito: Groq
          "groq/openai/gpt-oss-120b",
          // 3) Gratuito: OpenRouter (modelos ":free" mudam com frequência; troque se sair do ar)
          "openrouter/deepseek/deepseek-chat-v3-0324:free",
          // 4) Gratuito e local (opcional): exige Ollama + "ollama pull qwen2.5:14b"
          "ollama/qwen2.5:14b",
          // 5) PAGO - último recurso
          "anthropic/claude-haiku-5-5",
        ],
      },
      models: {
        "google/gemini-3.8-flash": { alias: "Gemini" },
        "groq/openai/gpt-oss-120b": { alias: "Groq" },
        "openrouter/deepseek/deepseek-chat-v3-0324:free": { alias: "OpenRouter" },
        "ollama/qwen2.5:14b": { alias: "Local" },
        "anthropic/claude-haiku-5-5": { alias: "Haiku" },
      },
    },
  },

  // ---- WhatsApp / Telegram (ative só depois de testar no navegador) ----
  // Mantenha "pairing" (padrão) ou "allowlist" com os números da equipe.
  // NUNCA use "open": qualquer pessoa poderia comandar o agente e ver dados de clientes.
  // channels: {
  //   whatsapp: {
  //     dmPolicy: "allowlist",
  //     allowFrom: ["+5511999999999"],
  //     groups: { "*": { requireMention: true } },
  //   },
  // },
}
