# Copie este arquivo para ".env" e preencha. NUNCA envie o .env para o GitHub.

# --- Gratuitos (crie as chaves; nenhuma pede cartão) ---
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Pago (último recurso) ---
# Console Anthropic: https://console.anthropic.com/ (créditos de API, separados da assinatura Claude Pro/Max)
ANTHROPIC_API_KEY=

# --- Chave interna entre OpenClaude e o proxy local (pode deixar assim) ---
LITELLM_MASTER_KEY=sk-escritorio-local

# --- Modelo padrão do OpenClaude: contabil | contabil-sigiloso ---
MODELO_PADRAO=contabil
