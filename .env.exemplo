# ============================================================
# Central Comercial — Moraes & Oliveira Contabilidade
# Copie para ".env" e preencha. Nunca envie o .env para o Git.
# ============================================================

# --- Servidor ---
PORTA=3333
URL_PUBLICA=https://comercial.seudominio.com.br     # endereço público (webhooks e link de descadastro)
SENHA_ADMIN=troque-por-uma-senha-forte
SEGREDO_SESSAO=troque-por-um-texto-aleatorio-longo
# IA_SIMULADA=1                                     # demonstração sem chaves de IA

# --- E-mail (envio por SMTP e leitura de respostas por IMAP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=587
SMTP_SEGURO=false
SMTP_USUARIO=comercial@seudominio.com.br
SMTP_SENHA=senha-de-app
SMTP_REMETENTE="Moraes & Oliveira <comercial@seudominio.com.br>"
IMAP_HOST=imap.gmail.com
IMAP_PORTA=993

# --- WhatsApp ---
# cloud = API oficial do WhatsApp Business (recomendado) | evolution = Evolution API (não oficial)
WHATSAPP_PROVEDOR=cloud
WA_CLOUD_TOKEN=
WA_CLOUD_ID_NUMERO=
WA_CLOUD_TOKEN_VERIFICACAO=um-texto-qualquer-para-validar-o-webhook
WA_CLOUD_SEGREDO_APP=
WA_NOME_MODELO=primeiro_contato_escritorio            # modelo aprovado pela Meta (ver docs/WHATSAPP.md)
WA_IDIOMA_MODELO=pt_BR
# EVOLUTION_URL=http://localhost:8080
# EVOLUTION_CHAVE_API=
# EVOLUTION_INSTANCIA=comercial
# EVOLUTION_TOKEN_WEBHOOK=

# --- Quem o sistema chama quando o lead quer falar com uma pessoa ---
RESPONSAVEL_NOME=Fábio
RESPONSAVEL_EMAIL=
RESPONSAVEL_WHATSAPP=55119XXXXXXXX

# --- Provedores de IA gratuitos (defina quantos quiser; o rodízio usa todos) ---
GROQ_API_KEY=            # https://console.groq.com/keys
CEREBRAS_API_KEY=        # https://cloud.cerebras.ai
GEMINI_API_KEY=          # https://aistudio.google.com/apikey
OPENROUTER_API_KEY=      # https://openrouter.ai/keys
SAMBANOVA_API_KEY=       # https://cloud.sambanova.ai
MISTRAL_API_KEY=         # https://console.mistral.ai
GITHUB_MODELS_TOKEN=     # token do GitHub com permissão "models"
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
OLLAMA_URL=              # ex.: http://localhost:11434 (IA local, sem limite)
# Trocar modelo de um provedor: IA_MODELO_GROQ=llama-3.1-8b-instant
