# Copie para .env (o .env NUNCA vai para o Git) e preencha.
ITABORAI_CNPJ=
ITABORAI_IM=
ITABORAI_IE=
# Só para o webservice da Prefeitura de Itaboraí: portal NFS-e > menu "Chave Privada Webservice".
# Quem emite pelo Emissor Nacional (nfse.gov.br) deixa em branco: as notas são assinadas com o certificado A1,
# selecionado na tela em Configurações > Empresa emissora e credenciais.
ITABORAI_CHAVE=
# S = optante do Simples Nacional
ITABORAI_SIMPLES=S
ITABORAI_INCENTIVO=N
# Próximo número de RPS (continue a sequência atual da empresa) e do lote
ITABORAI_PROXIMO_RPS=1
ITABORAI_PROXIMO_LOTE=1
# Produção: só funciona com as DUAS linhas abaixo preenchidas
ITABORAI_AMBIENTE=homologacao
ITABORAI_CIENTE_IRREVERSIVEL=NAO
# Pasta com os XML das notas ja emitidas (o INICIAR.bat cadastra os clientes sozinho)
# ITABORAI_PASTA_XML=C:\NFSE\XML da empresa
